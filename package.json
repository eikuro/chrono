{
  "name": "workspace-chrono",
  "version": "0.0.0",
  "private": true,
  "description": "Markdown-based Workspace engineering journal.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "astro build",
    "check": "prettier --check . && astro check && astro build",
    "dev": "astro dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "preview": "astro preview"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.3",
    "prettier": "^3.8.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}

---
interface Props {
  description: string;
  title: string;
}

const { description, title } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${baseUrl}/aurora.png`} />
    <link rel="canonical" href={Astro.url} />
    <title>{title} | Workspace Chrono</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${import.meta.env.BASE_URL}`}>
        <span class="brand-copy">
          <strong>Workspace</strong>
          <small>Engineering notes</small>
        </span>
      </a>
      <a class="header-link" href="https://github.com/organisation/chrono">GitHub</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>Workspace Chrono</span>
      <span>{new Date().getFullYear()}</span>
    </footer>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap');

  :root {
    --ink: #202522;
    --muted: #6b746f;
    --paper: #ffffff;
    --paper-deep: #f1f3f2;
    --signal: #315cce;
    --line: #e2e6e3;
    font-family: 'IBM Plex Sans', sans-serif;
    color: var(--ink);
    background: var(--paper);
    font-synthesis: none;
    line-height: 1.6;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 320px;
    background: var(--paper);
  }

  a {
    color: inherit;
  }

  .site-header,
  .site-footer,
  main {
    width: min(960px, calc(100% - 48px));
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    text-decoration: none;
  }

  .brand-copy strong,
  .brand-copy small {
    display: block;
  }

  .brand-copy strong {
    font-size: 15px;
    font-weight: 600;
  }

  .brand-copy small,
  .header-link,
  .site-footer,
  .eyebrow,
  time {
    color: var(--muted);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
  }

  .header-link {
    text-decoration: none;
  }

  .header-link:hover,
  .header-link:focus-visible {
    color: var(--signal);
  }

  main {
    min-height: calc(100vh - 160px);
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0 28px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 640px) {
    .site-header,
    .site-footer,
    main {
      width: min(100% - 32px, 1080px);
    }

    .site-header {
      padding: 18px 0;
    }

    .site-footer {
      flex-direction: column;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publishedPosts, type Post } from '../lib/posts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const postHref = (entry: Post) => `${base}/posts/${entry.id}/`;
const languageOrder = (entry: Post) => (entry.data.lang === 'en' ? 0 : 1);

// One row per work: language variants of the same post share a translation key,
// so the archive lists each title once and links each language on its own.
const posts = await publishedPosts();
const groups = new Map<string, Post[]>();

for (const post of posts) {
  const variants = groups.get(post.data.translationKey);
  if (variants) {
    variants.push(post);
  } else {
    groups.set(post.data.translationKey, [post]);
  }
}

const works = [...groups.values()]
  .map((variants: Post[]) =>
    variants.sort((first: Post, second: Post) => languageOrder(first) - languageOrder(second)),
  )
  .sort((first: Post[], second: Post[]) => second[0].data.date.valueOf() - first[0].data.date.valueOf());
---

<BaseLayout
  title="Case studies"
  description="Case studies in engineering judgement: where a boundary belongs, what a model should refuse to cover, and what evidence makes a decision safe to build on."
>
  <section class="intro">
    <h1>Interfaces that<br /><em>outlive their inputs.</em></h1>
    <p class="intro-copy">
      A good interface keeps working after the facts that produced it have changed. These are
      case studies of how that happens in practice: where a boundary gets drawn, what a model
      deliberately leaves out, and what evidence makes the result safe to build on. The first is a
      colour standard from 1931 that still decides what your screen shows.
    </p>
  </section>

  <section class="archive" aria-labelledby="archive-heading">
    <div class="archive-heading">
      <p class="eyebrow">Archive</p>
      <h2 id="archive-heading">Recent writing</h2>
    </div>
    <div class="post-list">
      {
        works.map((variants: Post[], index: number) => {
          const primary = variants[0];

          return (
            <div class="post-card">
              <span class="post-number">{String(index + 1).padStart(2, '0')}</span>
              <div class="post-copy">
                <span class="post-meta">
                  <time datetime={primary.data.date.toISOString()}>
                    {primary.data.date.toLocaleDateString('en-GB', {
                      day: '2-digit',
                      month: 'short',
                      year: 'numeric',
                    })}
                  </time>
                  <span>·</span>
                  <span>{primary.data.tags[0] ?? primary.data.type}</span>
                </span>
                {variants.map((variant: Post, variantIndex: number) => (
                  <a
                    class={variantIndex === 0 ? 'post-title' : 'post-title post-title-alt'}
                    href={postHref(variant)}
                    hreflang={variant.data.lang}
                    lang={variant.data.lang}
                  >
                    <span>{variant.data.name}</span>
                    {variantIndex === 0 && (
                      <span class="post-arrow" aria-hidden="true">
                        ↗
                      </span>
                    )}
                  </a>
                ))}
                <span class="post-description">{primary.data.description}</span>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 680px;
    padding: clamp(56px, 8vw, 96px) 0 80px;
  }

  .eyebrow {
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 20px;
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 500;
    line-height: 1.1;
  }

  h1 em {
    color: var(--signal);
    font-style: normal;
  }

  .intro-copy {
    max-width: 550px;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 17px;
  }

  .archive {
    display: grid;
    grid-template-columns: 176px 1fr;
    gap: 40px;
    padding-bottom: 80px;
  }

  h2 {
    margin-bottom: 0;
    font-size: 18px;
    font-weight: 600;
  }

  .post-list {
    border-top: 1px solid var(--line);
  }

  .post-card {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
    align-items: start;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .post-number {
    color: var(--muted);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
  }

  .post-meta {
    display: flex;
    gap: 8px;
    margin-bottom: 8px;
  }

  .post-title {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 8px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .post-title:hover,
  .post-title:focus-visible {
    color: var(--signal);
  }

  .post-title-alt {
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
  }

  .post-description {
    display: block;
    color: var(--muted);
    font-size: 14px;
  }

  .post-arrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 16px;
  }

  @media (max-width: 720px) {
    .intro {
      padding-bottom: 64px;
    }

    .archive {
      display: block;
      padding-bottom: 64px;
    }

    .archive-heading {
      margin-bottom: 20px;
    }
  }
</style>

# .gitignore syntax
#
# # comment
#   Comments begin with #; escape it as \# when matching a literal #.
#
# example.ts
#   Without /, the pattern matches at any directory level.
#
# /example.ts
#   A leading / anchors the pattern to this repository root.
#
# example/
#   A trailing / matches directories only.
#   Note - When a symlink point to a directory:
#   - <symlink>/ would match the directory content
#   - <symlink> would only match the symlink itself
#
# *.vsix
#   * matches any characters except /. This matches *.vsix at any level.
#
# a/**/b
#   ** matches zero or more directories, so this matches a/b and a/x/y/b.
#
# /**.vsix
#   This is root-anchored and is not equivalent to *.vsix.
#
# ?.tmp and [abc].tmp
#   ? matches one character; [abc] matches one listed character.
#
# !example.ts
#   ! re-includes a path. Rules are applied top to bottom, so order matters.
#
# output/*
#   Ignore a directory's contents while keeping the directory itself.
#   A negation cannot re-include a file inside an ignored parent directory.

#
#   Blacklist
#

# global conventions
# > a leading dot and a leading underscore are ignored everywhere; the whitelist
# > below re-includes the paths a repository commits on purpose
.*
_*

# credentials
*.crt

# dependencies
/node_modules/

# build and packaging output
.vscode-test/
coverage/
dist/
out/
releases/
*.vsix

# runtime output
# > ignore any root cache directories
# > ignore the shared storage mount, which holds data outside the repository
/*cache*
!/logo.png
/storage

# tooling output files
*.log
*.tsbuildinfo
.eslintcache

# generated documentation graphs
# > D2 HTML twins are local render aids; the committed artefact is the SVG twin
# > the globstar covers a twin under `html/` and one rendered beside its source
**/graph/**/*.html

# consumer-only config and agent symlinks
/.agents
/.claude
/.codex
/.github/copilot-instructions.md
/.github/hooks
/.github/agents
/.mcp.json
/AGENTS.md

# porter-materialised tool links and scratch space
/tmp/


#
#   Whitelist
#

# allow __ module paths (e.g. __tests__/, __mocks__/); a single _ stays ignored
!__*/

# allow common Git metadata files
# > !.git* also matches .git, but git hard-codes skipping the .git dir
!.git*

# allow config files a consumer receives as copies rather than symlinks
!/.node-version
!/.npmrc
!/.pre-commit-config.yaml
!/.prettierignore
!/.prettierrc.json

# allowed symlinked content for agent discovery
# > a trailing / matches directories only, so a materialised symlink stays
# > untracked while a real directory keeps its content visible
!/.agents/
!/.vscode/

#
#   Exceptions
#

# Serena defect workaround: `gather_source_files` walks with followlinks=True
# and matches with pathspec, not git, where a `/dir/` negation un-ignores the
# whole subtree. `!/.agents/` above therefore re-includes this self-link unless
# this rule is the last match; without it the walk descends the loop to the
# symlink limit (ELOOP on open) and re-enumerates the shared tree once per
# level. git needs no such rule, and the link cannot be deleted because porter
# recreates it.
.agents/.agents

# File-walker workaround: the `!.git*` whitelist above keeps `.gitignore`,
# `.gitattributes`, and `.gitkeep` trackable under `.*`, but walkers that read
# gitignore files as their ignore source (ripgrep, VS Code search, fd) also
# un-hide real `.git` directories with it; git itself hard-codes skipping
# `.git` and needs no rule. This re-ignores every repository's object store
# and must stay the last match for those paths.
.git/

#
#   Repo-specific Entries
#

# consumer-only config and agent symlinks
/cspell.config.yaml
